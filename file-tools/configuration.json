{
    "checksumAlgorithms": [ "XOR", "MD5" ],
    "fileCopyChunkSize": 1048576,

    "assemblerFileSources": [
        { "path": "d:\\Users", "readOnly": false },
        { "path": "/mount/Prod", "readOnly": true }
    ],

    "folderSortRules": [
        { "source": "To-Backup", "destination": "d:\\Backups", "comment": "File backups",
            "includeParentFolder": true, "addCurrentDateToDestinationFolderName": true },
        { "source": "To-Process", "destination": "d:\\To-Process", "comment": "File processing queue",
            "includeParentFolder": true, "addCurrentDateToDestinationFolderName": false }
    ],

    "fileDuplicationsGroups": [
        { "name": "Upload", "readOnly": false, "priority": 10, "paths": [
            "D:\\Upload", "/mnt/upload"]},
        { "name": "Prod", "readOnly": true, "priority": 20, "paths": [
            "D:\\Prod", "/mnt/prod"]},
		{ "name": "Trash", "readOnly": true, "priority": 30, "paths": [
            "D:\\Trash", "/mnt/trash"]}
    ],

    "fileDatabaseMinimalSaveIntervalInMS": 300000,
    "snapshotMinimalSaveIntervalInMS": 300000,

    "progressPrinterDotDataSize": 67108864,
    "progressPrinterDotsPerLine": 100
}
